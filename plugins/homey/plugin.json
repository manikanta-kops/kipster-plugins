      "needsAddress": false,
      "accountTypes": ["personal", "business"],
      "cost": "free",
      "products": [
        {
          "name": "Homey",
          "rank": 1248,
          "category": "smart-home",
          "website": "https://homey.app",
          "accounts": "yes",
          "cost": "free",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "partly",
            "checkedOn": "2026-10-09",
            "notes": "Athom's official Homey MCP server (device status and control, Flows, Moods) is added by URL in any connector-capable client and signs in with the person's Homey account; Homey Cloud starts free. Discovery 2026-10-09: DCR yes (registration at mcp.athom.com/oauth2/client), CIMD no, client_secret_basic, no code_challenge_methods advertised.",
            "sources": [
              "https://homey.app/en-us/news/introducing-the-homey-mcp-server/",
              "https://mcp.athom.com/.well-known/oauth-protected-resource",
              "https://mcp.athom.com/.well-known/oauth-authorization-server"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "sign-in-changed",
        "signIn": ["dcr"],
        "checkedOn": "2026-10-13",
        "reason": "Authorization server does not advertise S256 PKCE"
      }
    }
