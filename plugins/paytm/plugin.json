{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "paytm",
  "version": "0.1.0",
  "description": "Connect to Paytm through its official MCP server.",
  "homepage": "https://paytm.com",
  "license": "Apache-2.0",
  "extensions": {
    "app.kipster": {
      "id": "paytm",
      "name": "Paytm",
      "category": "payments",
      "website": "https://paytm.com",
      "signIn": ["dcr"],
      "needsAddress": false,
      "accountTypes": ["business-only"],
      "cost": "free",
      "products": [
        {
          "name": "Paytm",
          "rank": 858,
          "category": "payments",
          "website": "https://paytm.com",
          "accounts": "business-only",
          "cost": "free",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "partly",
            "checkedOn": "2026-10-09",
            "notes": "Paytm's official MCP signs in a Paytm merchant account (dashboard login and OTP) for payment links, refunds, settlements and subscriptions; docs say the merchant needs MCP access enabled, and the consumer wallet and UPI history have no API. Paytm Travel also lists a public flight and bus search MCP (travel.paytm.com/mcp/mcp). Discovery 2026-10-09: DCR yes, CIMD no, PKCE methods not advertised.",
            "sources": [
              "https://paytmpayments.com/docs/mcp-server-overview",
              "https://mcp.paytmpayments.com/.well-known/oauth-protected-resource",
              "https://mcp.paytmpayments.com/.well-known/oauth-authorization-server",
              "https://preoauth.paytmpayments.com/.well-known/oauth-authorization-server"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "sign-in-changed",
        "signIn": ["dcr"],
        "checkedOn": "2026-10-13",
        "reason": "Authorization server does not advertise S256 PKCE"
      }
    }
  }
}
