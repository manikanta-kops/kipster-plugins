{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "digitalocean",
  "version": "0.1.0",
  "description": "Connect to DigitalOcean through its official MCP server.",
  "homepage": "https://www.digitalocean.com",
  "license": "Apache-2.0",
  "extensions": {
    "app.kipster": {
      "id": "digitalocean",
      "name": "DigitalOcean",
      "category": "cloud-and-hosting",
      "website": "https://www.digitalocean.com",
