      "accountTypes": ["personal", "business"],
      "cost": "user-paid-plan",
      "products": [
        {
          "name": "DigitalOcean",
          "rank": 1604,
          "category": "cloud-and-hosting",
          "website": "https://www.digitalocean.com",
          "accounts": "yes",
          "cost": "user-paid-plan",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "yes",
            "checkedOn": "2026-10-08",
