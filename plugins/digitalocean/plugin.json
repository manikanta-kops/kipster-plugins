              "https://docs.digitalocean.com/reference/mcp/configure-mcp/",
              "https://apps.mcp.digitalocean.com/.well-known/oauth-protected-resource",
              "https://cloud.digitalocean.com/.well-known/oauth-authorization-server"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "error",
        "signIn": [],
        "checkedOn": "2026-10-13",
        "reason": "Protected resource metadata does not match the MCP endpoint"
      }
    }
