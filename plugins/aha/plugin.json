{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "aha",
  "version": "0.1.0",
  "description": "Connect to Aha! through its official MCP server.",
  "homepage": "https://www.aha.io",
  "license": "Apache-2.0",
  "extensions": {
    "app.kipster": {
      "id": "aha",
      "name": "Aha!",
      "category": "project-management",
      "website": "https://www.aha.io",
      "signIn": ["dcr"],
      "needsAddress": true,
      "addressPrompt": "What is your Aha! instance or account MCP address?",
      "accountTypes": ["personal", "business"],
      "cost": "user-paid-plan",
      "products": [
        {
          "name": "Aha!",
          "rank": 1352,
          "category": "project-management",
          "website": "https://www.aha.io",
          "accounts": "yes",
          "cost": "user-paid-plan",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "yes",
            "checkedOn": "2026-10-08",
            "notes": "Per-account endpoint ({domain} is the account's aha.io subdomain), enabled in AI controls. Discovery 2026-10-08 (aha.aha.io): DCR yes, CIMD not advertised, S256, token auth client_secret_post.",
            "sources": [
              "https://www.aha.io/blog/introducing-the-aha-software-mcp-server",
              "https://aha.aha.io/.well-known/oauth-protected-resource/api/v1/mcp",
              "https://aha.aha.io/.well-known/oauth-authorization-server"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "needs-address",
        "signIn": [],
        "checkedOn": "2026-10-13",
        "reason": "An instance or account MCP address is required when connecting"
      }
    }
  }
}
