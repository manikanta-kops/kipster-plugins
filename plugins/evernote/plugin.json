{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "evernote",
  "version": "0.1.0",
  "description": "Connect to Evernote through its official MCP server.",
  "homepage": "https://evernote.com",
  "license": "Apache-2.0",
  "extensions": {
    "app.kipster": {
      "id": "evernote",
      "name": "Evernote",
      "category": "notes",
      "website": "https://evernote.com",
      "signIn": ["dcr"],
      "needsAddress": false,
      "accountTypes": ["personal", "business"],
      "cost": "user-paid-plan",
      "products": [
        {
          "name": "Evernote",
          "rank": 56,
          "category": "notes",
          "website": "https://evernote.com",
          "accounts": "yes",
          "cost": "user-paid-plan",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "yes",
            "checkedOn": "2026-10-09",
            "notes": "Evernote's own remote MCP server signs in with OAuth and dynamic client registration and works on paid personal, Business and Teams plans, not free Basic; it is an open beta with no waitlist or access request, though Evernote says it 'is rolling out gradually' and ineligible accounts see a message when connecting. The legacy API is deprecated. Discovery 2026-10-08: DCR yes, CIMD no, S256, public clients (auth method none); Registry 2026-10-08: only a community entry (github.com/verygoodplugins/mcp-evernote).",
            "sources": [
              "https://evernote.com/mcp",
              "https://dev.evernote.com/mcp",
              "https://mcp.evernote.com/mcp",
              "https://mcp.evernote.com/.well-known/oauth-protected-resource",
              "https://mcp.evernote.com/.well-known/oauth-authorization-server",
              "https://accounts.evernote.com/.well-known/oauth-authorization-server",
              "https://registry.modelcontextprotocol.io/v0/servers?search=evernote",
              "https://dev.evernote.com/mcp/faq",
              "https://dev.evernote.com/mcp/authentication",
              "https://dev.evernote.com/mcp/limitations"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "error",
        "signIn": [],
        "checkedOn": "2026-10-13",
        "reason": "Protected resource metadata does not match the MCP endpoint"
      }
    }
  }
}
