{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "adobe-creative",
  "version": "0.1.0",
  "description": "Connect to Adobe Lightroom, Adobe Illustrator through its official MCP server.",
  "homepage": "https://www.adobe.com/products/photoshop-lightroom.html",
  "license": "Apache-2.0",
  "extensions": {
    "app.kipster": {
      "id": "adobe-creative",
      "name": "Adobe Creative",
      "category": "photos",
      "website": "https://www.adobe.com/products/photoshop-lightroom.html",
      "signIn": ["dcr"],
      "needsAddress": false,
      "accountTypes": ["personal", "business"],
      "cost": "free",
      "products": [
        {
          "name": "Adobe Lightroom",
          "rank": 236,
          "category": "photos",
          "website": "https://www.adobe.com/products/photoshop-lightroom.html",
          "accounts": "yes",
          "cost": "free",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "partly",
            "checkedOn": "2026-10-08",
            "notes": "Adobe announced its hosted Adobe for creativity MCP with Lightroom, Photoshop and other tools (shown in Claude; other clients not mentioned); a free Adobe account works, with higher limits on paid plans. Discovery 2026-10-08: auth server ims-na1.adobelogin.com, DCR yes, CIMD not advertised, S256, client-secret token auth; scopes cover llm.assets only, so the person's Lightroom cloud library still needs the entitled-partner Lightroom API. Registry 2026-10-08: only community Adobe servers.",
            "sources": [
              "https://blog.adobe.com/en/publish/2026/04/28/adobe-for-creativity-connector",
              "https://adobe-creativity.adobe.io/.well-known/oauth-protected-resource/mcp",
              "https://ims-na1.adobelogin.com/.well-known/oauth-authorization-server",
              "https://developer.adobe.com/lightroom/lightroom-api-docs/getting-started/",
              "https://github.com/AdobeDocs/lightroom-public-apis",
              "https://registry.modelcontextprotocol.io/v0/servers?search=adobe"
            ]
          }
        },
        {
          "name": "Adobe Illustrator",
          "rank": 1430,
          "category": "design-and-creative",
          "website": "https://www.adobe.com/products/illustrator.html",
          "accounts": "yes",
          "cost": "free",
          "signIn": "oauth-dcr",
          "research": {
            "verified": "partly",
            "checkedOn": "2026-10-08",
            "notes": "Adobe's hosted Adobe for creativity MCP includes Illustrator capabilities per Adobe's announcement; sign-in through Adobe IMS with DCR and S256, free Adobe account with higher limits on paid plans. It creates new work rather than opening the person's local Illustrator files.",
            "sources": [
              "https://blog.adobe.com/en/publish/2026/04/28/adobe-for-creativity-connector",
              "https://adobe-creativity.adobe.io/.well-known/oauth-protected-resource/mcp",
              "https://developer.adobe.com/illustrator/"
            ]
          }
        }
      ],
      "tools": {},
      "probe": {
        "result": "error",
        "signIn": [],
        "checkedOn": "2026-10-13",
        "reason": "Expected HTTP 401; received HTTP 403"
      }
    }
  }
