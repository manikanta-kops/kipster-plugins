{
  "name": "kipster-plugins",
  "private": true,
  "description": "Plugins that connect Kipster's kips to the services people use.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test && npm run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node src/catalogue/validate-cli.ts",
    "import": "node src/importer/cli.ts",
    "probe": "node src/probe/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.9",
    "typescript": "5.9"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3"
  }
}
