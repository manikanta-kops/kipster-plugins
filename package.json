{
  "name": "@kipster/plugins",
  "version": "0.2.0",
  "private": true,
  "description": "Plugins that connect Kipster's kips to the services people use.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "files": [
    "dist",
    "plugins",
    "schemas",
    "test/fixtures/catalogue",
    ".prettierrc.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "kipster-plugins": "dist/server/cli.js"
  },
  "exports": {
    ".": "./dist/server/server.js",
    "./fixture": "./dist/fixture/service.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run validate && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node src/catalogue/validate-cli.ts",
    "import": "node src/importer/cli.ts",
    "probe": "node src/probe/cli.ts",
    "fixture": "node src/fixture/cli.ts",
    "serve": "node src/server/cli.ts",
    "mcp": "node src/mcp/cli.ts",
    "instance": "node src/dev/instance.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.9",
    "typescript": "5.9"
  }
}
