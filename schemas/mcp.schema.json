{
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
    },
    "mcpServers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["streamable-http", "sse"]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://"
          }
        },
        "required": ["type", "url"],
        "additionalProperties": false
      }
    }
  },
  "required": ["$schema", "mcpServers"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kipster class A remote MCP configuration"
}
